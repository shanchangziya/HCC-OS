# Copy to config/paths.env, replace placeholders, then run:
#   source config/paths.env
# Never commit config/paths.env or credentials.

export HCC_OS_RSCRIPT="Rscript"
export HCC_OS_R_LIBRARY="/path/to/optional/R/library"

# Discovery and independent single-cell inputs
export HCC_OS_DISCOVERY_ROOT="/path/to/discovery_analysis_root"
export HCC_OS_GSE149614_COUNTS="/path/to/GSE149614_HCC.scRNAseq.S71915.count.fresh.txt.gz"
export HCC_OS_GSE149614_METADATA_CSV="/path/to/GSE149614_metadata_annotated.csv"
export HCC_OS_GSE149614_METADATA="/path/to/GSE149614_HCC.metadata.updated.txt.gz"
export HCC_OS_GSE149614_RDS="/path/to/GSE149614_validation_atlas.rds"

# Bulk/model inputs
export HCC_OS_FROZEN_RESULT="/path/to/res_no_GSE14520.Rdata"
export HCC_OS_MODEL_RAW_DIR="/path/to/isolated_tcga_model_inputs"
export HCC_OS_EXTERNAL_DATA_ROOT="/path/to/external_cohort_root"
export HCC_OS_ICGC_FPKM="/path/to/Merge_RNAseq_FKPM_Symbol.txt"
export HCC_OS_LEGACY_PROJECT_ROOT="/path/to/frozen_manuscript_analysis_root"
export HCC_OS_TCGA_CLINICAL_GRADE="/path/to/Fig4_TCGA_OSARS_clinical_all_matched.csv"

# Immune, spatial, proteomic, and pathology inputs
export HCC_OS_IMMUNE_INPUT_DIR="/path/to/FIG5_inputs"
export HCC_OS_SPATIAL_WORKDIR="/path/to/cell2location_misty_workdir"
export HCC_OS_PROTEOMICS_ROOT="/path/to/proteomics_source_root"
export HCC_OS_PDC_SURROGATE_WEIGHTS="/path/to/CPTAC_OSARS_protein_surrogate_weights.csv"
export HCC_OS_PDC_SURROGATE_SCORES="/path/to/CPTAC_OSARS_protein_surrogate_scores_OS_RFS.csv"
export HCC_OS_PATHOLOGY_SOURCE_DIR="/path/to/pathology_data_raw"
export HCC_OS_PATHOLOGY_CLINICAL="/path/to/Fig4_TCGA_OSARS_clinical_all_matched.csv"
export HCC_OS_PATHOLOGY_PRIOR_PERFORMANCE="/path/to/prior/pathology/performance_metrics.csv"
export HCC_OS_PATHOLOGY_ORIGINAL_PATHDAT="/path/to/pathdat.Rdata"

# Optional execution controls
export OSARS_MAX_JOBS="24"
export WRITE_H5AD="0"
export MAX_CELLS_PER_TYPE="3000"
export SKIP_SC_EXPORT="0"
